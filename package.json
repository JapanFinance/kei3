{
  "name": "kei3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "size": "node .github/size-report.mjs measure",
    "lighthouse": "node .github/lighthouse-run.mjs local",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts --reporter=default",
    "bench:baseline": "npm run bench -- --mode baseline",
    "bench:compare": "npm run bench -- --mode compare",
    "profile": "npm run bench -- --mode profile",
    "deploy": "npm run build && wrangler deploy",
    "build:preview": "tsc -b && vite build --mode preview",
    "deploy:preview": "npm run build:preview && wrangler deploy",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "chart.js": "^4.5.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-number-format": "^5.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^30.0.1",
    "lighthouse": "13.5.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": "oxlint --fix --no-error-on-unmatched-pattern"
  }
}
