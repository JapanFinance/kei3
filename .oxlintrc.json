{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "perf": "error" },
  "options": { "typeAware": true },
  "plugins": ["typescript", "oxc", "unicorn", "react"],
  "ignorePatterns": [
    "dist",
    ".agent/**",
    ".agents/**",
    ".claude",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "scripts/oxlint-plugins/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "local", "specifier": "./scripts/oxlint-plugins/local.js" },
    { "name": "anti-slop", "specifier": "./scripts/oxlint-plugins/anti-slop/index.ts" }
  ],
  "rules": {
    "no-restricted-imports": ["error", { "patterns": [{ "regex": "^@mui/[^/]+$" }] }],
    "local/license-header": "error",
    "local/no-jsx-unicode-escape": "error",
    "local/no-object-literal-accessor": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true, "allowBoolean": true }
    ],
    "react/jsx-key": "off",
    "react/no-array-index-key": "off",
    "react/no-object-type-as-default-prop": "off",
    "unicorn/prefer-set-has": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", ".github/**/*.mjs"],
      "rules": { "anti-slop/no-runtime-typeof": "off" }
    },
    {
      "files": [
        "src/data/rate.ts",
        "src/components/TakeHomeCalculator/ResultRow.tsx",
        "src/utils/healthInsuranceCalculator.ts"
      ],
      "rules": { "anti-slop/no-runtime-typeof": "off" }
    },
    {
      "files": [
        "test-setup.ts",
        "src/__tests__/App_ModeSwitching.test.tsx",
        "src/__tests__/BlueFilerDisplay.test.tsx",
        "src/__tests__/ForeignTaxCreditTooltips.test.tsx",
        "src/__tests__/FurusatoNozeiTab.test.tsx",
        "src/__tests__/HighIncomeMinimumTaxTooltip.test.tsx",
        "src/__tests__/IncomeBasedPortionTooltip.test.tsx",
        "src/__tests__/IncomeModeTransitions.test.tsx",
        "src/__tests__/InputForm.test.tsx",
        "src/__tests__/MunicipalNonTaxableDisplay.test.tsx",
        "src/__tests__/NegativeTakeHomeTooltip.test.tsx",
        "src/__tests__/NetBusinessAndMiscIncomeTooltip.test.tsx",
        "src/__tests__/NetEmploymentIncomeTooltip.test.tsx",
        "src/__tests__/NetRealEstateIncomeTooltip.test.tsx",
        "src/__tests__/PersonalDeductionsDisplay.test.tsx",
        "src/__tests__/PublicPensionIncomeRows.test.tsx",
        "src/__tests__/ReportedInvestmentIncomeRows.test.tsx",
        "src/__tests__/ResidenceTaxCreditTooltip.test.tsx",
        "src/__tests__/SocialInsuranceTab.test.tsx",
        "src/__tests__/TakeHomeChart.test.tsx"
      ],
      "rules": { "anti-slop/no-module-mocking": "off" }
    },
    {
      "files": ["src/__tests__/**/*.{ts,tsx}"],
      "plugins": ["typescript", "oxc", "unicorn", "react", "vitest"],
      "rules": { "vitest/require-mock-type-parameters": "off" }
    }
  ]
}
